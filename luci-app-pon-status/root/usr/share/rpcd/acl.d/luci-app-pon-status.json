{
	"luci-app-pon-status": {
		"description": "Grant access to PON optical status and port rate for the overview page",
		"read": {
			"ubus": {
				"file": [ "read", "exec" ]
			},
			"uci": [ "pon" ],
			"file": {
				"/usr/sbin/ponctl status --json": [ "exec" ],
				"/usr/sbin/ponctl --device * status --json": [ "exec" ],
				"/sys/class/net/*/statistics/rx_bytes": [ "read" ],
				"/sys/class/net/*/statistics/tx_bytes": [ "read" ]
			}
		}
	}
}
