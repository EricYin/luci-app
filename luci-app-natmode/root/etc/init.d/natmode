#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0
#

START=99
STOP=90

USE_PROCD=1

APPLY_BIN=/usr/sbin/natmode-apply

natmode_apply() {
	if [ -x "$APPLY_BIN" ]; then
		"$APPLY_BIN" "$@"
	else
		/bin/sh "$APPLY_BIN" "$@"
	fi
}

fix_perm() {
	[ -x "$APPLY_BIN" ] || chmod 0755 "$APPLY_BIN" 2>/dev/null
}

bootstrap_rules() {
	(
		i=0
		while [ "$i" -lt 15 ]; do
			i=$((i + 1))
			sleep 4
			[ "$(uci -q get natmode.main.mode 2>/dev/null)" = "symmetric" ] || break
			natmode_apply reapply >/dev/null 2>&1
			r="$(natmode_apply status 2>/dev/null |
				sed -n 's/^random_rules=//p')"
			[ -n "$r" ] && [ "$r" != "0" ] && break
		done
	) &
}

start_service() {
	procd_open_instance
	procd_close_instance

	if ! "$0" enabled >/dev/null 2>&1; then
		"$0" enable >/dev/null 2>&1
		logger -t natmode "已重建开机自启链接（此前未启用）"
	fi

	fix_perm
	natmode_apply apply >/dev/null 2>&1
	bootstrap_rules
}

reload_service() {
	natmode_apply reapply >/dev/null 2>&1
}

stop_service() {
	natmode_apply cleanup >/dev/null 2>&1
	return 0
}

service_triggers() {
	procd_add_reload_trigger firewall
	procd_add_reload_trigger natmode
	procd_add_raw_trigger "interface.*" 5000 /etc/init.d/natmode reload
}
