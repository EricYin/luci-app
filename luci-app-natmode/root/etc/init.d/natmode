#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0
#
# 必须在 fw4（START=19）之后、且尽量靠后：NAT4 的随机端口规则要插进 fw4 的
# srcnat_<zone> 链，链还没生成时插入等于没注入 —— 「重启后必须打开 NAT 类型
# 页才生效」的原因。

# START/STOP/USE_PROCD 是 rc.common 框架约定变量，shellcheck 不认识
# shellcheck disable=SC2034
START=99
STOP=90

USE_PROCD=1

# ── 调起 helper ────────────────────────────────────────────────────
# 编译固件时预装的话 postinst 不会跑，仓库里若是 0644 就会原样进固件，
# 没有 x 位时内核 exec 会直接拒绝（「Permission denied」），开机注入
# 静默失败 —— 页面于是每次都显示「已自动修复」。
# 所以：先尝试补权限，补不上（/usr 只读等）就退化成 /bin/sh 解释执行。
APPLY_BIN=/usr/sbin/natmode-apply

natmode_apply() {
	if [ -x "$APPLY_BIN" ]; then
		"$APPLY_BIN" "$@"
	else
		/bin/sh "$APPLY_BIN" "$@"
	fi
}

# 开机第一件事：把 helper 的可执行位修回来，这样 rpcd file.exec 也能用。
fix_perm() {
	[ -x "$APPLY_BIN" ] || chmod 0755 "$APPLY_BIN" 2>/dev/null
}

# WAN 可能晚于本服务上线：后台幂等重试，直到规则真正生效。
# 15 次 x 4s = 60s，覆盖较慢的 PPPoE 拨号；更晚的事件由下面的
# interface raw trigger 兜底。
bootstrap_rules() {
	(
		i=0
		while [ "$i" -lt 15 ]; do
			i=$((i + 1))
			sleep 4
			[ "$(uci -q get natmode.main.mode 2>/dev/null)" = "symmetric" ] || break
			natmode_apply reapply >/dev/null 2>&1
			r="$(natmode_apply status 2>/dev/null |
				sed -n 's/^random_rules=//p')"
			[ -n "$r" ] && [ "$r" != "0" ] && break
		done
	) &
}

start_service() {
	procd_open_instance
	procd_close_instance

	# apk 运行时安装不会建 rc.d 软链，服务可能从未在开机跑过 → 顺手补 enable
	if ! "$0" enabled >/dev/null 2>&1; then
		"$0" enable >/dev/null 2>&1
		logger -t natmode "已重建开机自启链接（此前未启用）"
	fi

	fix_perm
	natmode_apply apply >/dev/null 2>&1
	bootstrap_rules
}

reload_service() {
	natmode_apply reapply >/dev/null 2>&1
}

stop_service() {
	natmode_apply cleanup >/dev/null 2>&1
	return 0
}

service_triggers() {
	procd_add_reload_trigger firewall
	procd_add_reload_trigger natmode

	# 关键：WAN 上线（尤其 PPPoE）伴随 fw4 整表重建，开机注入的
	# fully-random 规则会被抹掉 —— 这正是「每次重启打开页面都提示
	# 已自动修复」的根源（此前只有打开页面时的 status 自愈能救场）。
	# 这里用 raw trigger 在任意接口事件后延迟 5 秒重跑 reapply，确保
	# 排在 fw4 自己的重载之后；短时间内的多个接口事件由 procd 合并。
	procd_add_raw_trigger "interface.*" 5000 /etc/init.d/natmode reload
}
